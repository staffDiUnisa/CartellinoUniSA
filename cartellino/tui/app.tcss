/* Stile globale della TUI: pulsanti blu, righe di pulsanti affiancati con un
   minimo di spazio tra loro (vedi classe .button-row, usata da dashboard.py,
   reports.py e folder_picker.py). */

Button {
    background: blue;
    color: white;
    text-style: bold;
    min-width: 20;
}

Button:hover {
    background: royalblue;
}

Button:focus {
    background: dodgerblue;
}

.button-row {
    height: auto;
    width: auto;
    margin-top: 1;
}

.button-row Button {
    margin-right: 1;
}

/* Righe che affiancano un campo (Input/MaskedInput) a un pulsante, es. "Sfoglia...":
   a differenza di .button-row NON impostano width: auto sul contenitore, altrimenti
   il campo si restringerebbe al contenuto invece di occupare lo spazio disponibile. */
.field-row {
    height: auto;
    margin-top: 1;
}

.field-row Button {
    margin-left: 1;
}

/* Input/MaskedInput hanno width: 100% di default: dentro .field-row va ridotta a
   1fr, altrimenti reclamano tutta la riga e spingono il pulsante fuori dal viewport
   (Horizontal ha overflow: hidden, quindi il pulsante sparirebbe silenziosamente). */
.field-row Input,
.field-row MaskedInput {
    width: 1fr;
}

/* Righe di pulsanti che devono restare visibili/navigabili quando il terminale
   si restringe: a differenza di .button-row (larghezza automatica, non va a capo),
   .button-grid usa ItemGrid per andare a capo su più righe invece di far uscire i
   pulsanti in eccesso dal viewport (issue GitHub #1, "Problemi di visualizzazione"). */
.button-grid {
    height: auto;
    grid-gutter: 1;
    margin-top: 1;
    margin-bottom: 1;
}

/* Menu di navigazione della Dashboard: un colore diverso per pulsante */
#btn-aggiorna {
    background: blue;
}
#btn-aggiorna:hover {
    background: royalblue;
}

