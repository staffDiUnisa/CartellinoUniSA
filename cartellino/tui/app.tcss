/* Stile globale della TUI: pulsanti blu, righe di pulsanti affiancati con un
   minimo di spazio tra loro (vedi classe .button-row, usata da dashboard.py,
   reports.py e folder_picker.py). */

Button {
    background: blue;
    color: white;
    text-style: bold;
    min-width: 20;
}

Button:hover {
    background: royalblue;
}

Button:focus {
    background: dodgerblue;
}

.button-row {
    height: auto;
    width: auto;
    margin-top: 1;
}

.button-row Button {
    margin-right: 1;
}

/* Righe che affiancano un campo (Input/MaskedInput) a un pulsante, es. "Sfoglia...":
   a differenza di .button-row NON impostano width: auto sul contenitore, altrimenti
   il campo si restringerebbe al contenuto invece di occupare lo spazio disponibile. */
.field-row {
    height: auto;
    margin-top: 1;
}

.field-row Button {
    margin-left: 1;
}

/* Input/MaskedInput hanno width: 100% di default: dentro .field-row va ridotta a
   1fr, altrimenti reclamano tutta la riga e spingono il pulsante fuori dal viewport
   (Horizontal ha overflow: hidden, quindi il pulsante sparirebbe silenziosamente). */
.field-row Input,
.field-row MaskedInput {
    width: 1fr;
}

/* Righe di pulsanti che devono restare visibili/navigabili quando il terminale
   si restringe: a differenza di .button-row (larghezza automatica, non va a capo),
   .button-grid usa ItemGrid per andare a capo su più righe invece di far uscire i
   pulsanti in eccesso dal viewport (issue GitHub #1, "Problemi di visualizzazione"). */
.button-grid {
    height: auto;
    grid-gutter: 1;
    margin-top: 1;
    margin-bottom: 1;
}

/* Menu di navigazione della Dashboard: un colore diverso per pulsante */
#btn-aggiorna {
    background: blue;
}
#btn-aggiorna:hover {
    background: royalblue;
}

#btn-report {
    background: darkgreen;
}
#btn-report:hover {
    background: green;
}

#btn-timesheet {
    background: darkorange;
}
#btn-timesheet:hover {
    background: orange;
}

#btn-statistiche-nav {
    background: teal;
}
#btn-statistiche-nav:hover {
    background: darkcyan;
}

#btn-impostazioni {
    background: purple;
}
#btn-impostazioni:hover {
    background: mediumpurple;
}

/* Schermata Statistiche: un colore diverso per categoria */
#btn-stat-ticket {
    background: darkgoldenrod;
}
#btn-stat-ticket:hover {
    background: goldenrod;
}

#btn-stat-ferie {
    background: darkgreen;
}
#btn-stat-ferie:hover {
    background: green;
}

#btn-stat-pmf {
    background: darkorange;
}
#btn-stat-pmf:hover {
    background: orange;
}

#btn-stat-erit {
    background: purple;
}
#btn-stat-erit:hover {
    background: mediumpurple;
}

#btn-stat-straordinari {
    background: crimson;
}
#btn-stat-straordinari:hover {
    background: indianred;
}

#btn-stat-vsg {
    background: darkslateblue;
}
#btn-stat-vsg:hover {
    background: slateblue;
}

#btn-stat-malattia {
    background: saddlebrown;
}
#btn-stat-malattia:hover {
    background: sienna;
}

/* Dashboard: pulsante senza colore dedicato finora (issue #9) */
#btn-controlla-aggiornamenti {
    background: steelblue;
}
#btn-controlla-aggiornamenti:hover {
    background: cornflowerblue;
}

/* Schermata Report e categoria "Riposo compensativo" in Statistiche: navigazione
   verso una sezione informativa, stesso colore per coerenza (issue #9) */
#btn-riposo,
#btn-credito,
#btn-statistiche,
#btn-ore-giornaliere,
#btn-stat-riposi {
    background: teal;
}
#btn-riposo:hover,
#btn-credito:hover,
#btn-statistiche:hover,
#btn-ore-giornaliere:hover,
#btn-stat-riposi:hover {
    background: darkcyan;
}

/* Esportazione riposi in txt (issue #9) */
#btn-export-riposi {
    background: cadetblue;
}
#btn-export-riposi:hover {
    background: steelblue;
}

/* Impostazioni/config: sfoglia cartella, gestisci date escluse, modifica
   credenziali (issue #9) */
#btn-date-escluse,
#btn-modifica-cred,
#btn-sfoglia-data-folder,
#btn-sfoglia-output-folder {
    background: purple;
}
#btn-date-escluse:hover,
#btn-modifica-cred:hover,
#btn-sfoglia-data-folder:hover,
#btn-sfoglia-output-folder:hover {
    background: mediumpurple;
}

/* Azioni distruttive/annulla (issue #9) */
#btn-rimuovi-cred,
#fp-annulla,
.date-esclusa-rimuovi {
    background: crimson;
}
#btn-rimuovi-cred:hover,
#fp-annulla:hover,
.date-esclusa-rimuovi:hover {
    background: indianred;
}

/* Azioni positive: aggiungi (issue #9) */
#btn-aggiungi {
    background: darkgreen;
}
#btn-aggiungi:hover {
    background: green;
}

/* Chiudi/neutro (issue #9) */
#btn-chiudi {
    background: gray;
}
#btn-chiudi:hover {
    background: darkgray;
}
