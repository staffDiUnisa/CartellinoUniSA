/* Stile globale della TUI: pulsanti blu, righe di pulsanti affiancati con un
   minimo di spazio tra loro (vedi classe .button-row, usata da dashboard.py,
   reports.py e folder_picker.py). */

Button {
    background: blue;
    color: white;
    text-style: bold;
}

Button:hover {
    background: royalblue;
}

Button:focus {
    background: dodgerblue;
}

.button-row {
    height: auto;
    width: auto;
}

.button-row Button {
    margin-right: 1;
}

/* Menu di navigazione della Dashboard: un colore diverso per pulsante */
#btn-aggiorna {
    background: blue;
}
#btn-aggiorna:hover {
    background: royalblue;
}

#btn-report {
    background: darkgreen;
}
#btn-report:hover {
    background: green;
}

#btn-timesheet {
    background: darkorange;
}
#btn-timesheet:hover {
    background: orange;
}

#btn-statistiche-nav {
    background: teal;
}
#btn-statistiche-nav:hover {
    background: darkcyan;
}

#btn-impostazioni {
    background: purple;
}
#btn-impostazioni:hover {
    background: mediumpurple;
}

/* Schermata Statistiche: un colore diverso per categoria */
#btn-stat-ticket {
    background: darkgoldenrod;
}
#btn-stat-ticket:hover {
    background: goldenrod;
}

#btn-stat-ferie {
    background: darkgreen;
}
#btn-stat-ferie:hover {
    background: green;
}

#btn-stat-pmf {
    background: darkorange;
}
#btn-stat-pmf:hover {
    background: orange;
}

#btn-stat-erit {
    background: purple;
}
#btn-stat-erit:hover {
    background: mediumpurple;
}

#btn-stat-straordinari {
    background: crimson;
}
#btn-stat-straordinari:hover {
    background: indianred;
}

#btn-stat-vsg {
    background: darkslateblue;
}
#btn-stat-vsg:hover {
    background: slateblue;
}

#btn-stat-malattia {
    background: saddlebrown;
}
#btn-stat-malattia:hover {
    background: sienna;
}
